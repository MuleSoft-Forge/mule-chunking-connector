        </munit:validation>
    </munit:test>

    <munit:test name="file-store-writes-chunks-beyond-max-in-memory-chunks-to-disk-test" description="file-store holds maxInMemoryChunks chunks in memory and writes the rest to a temporary file">
        <munit:execution>
            <set-variable variableName="bytesBefore" value="#[java!com::mulesoftforge::mule::extension::chunking::test::TempFiles::fileStoreBytes()]"/>
            <set-payload value="#[(1 to 50) map &quot;x&quot; joinBy &quot;&quot;]"/>
            <chunking:read-chunked><chunking:chunking-strategy><chunking:by-size chunkSize="5"/></chunking:chunking-strategy><chunking:streaming-strategy><chunking:file-store maxInMemoryChunks="2"/></chunking:streaming-strategy></chunking:read-chunked>
            <set-variable variableName="seen" value="#[0]"/>
            <foreach><set-variable variableName="seen" value="#[vars.seen + 1]"/></foreach>
            <set-variable variableName="onDisk" value="#[java!com::mulesoftforge::mule::extension::chunking::test::TempFiles::fileStoreBytes() - vars.bytesBefore]"/>
            <set-variable variableName="again" value="#[0]"/>
            <foreach><set-variable variableName="again" value="#[vars.again + 1]"/></foreach>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.seen]" is="#[MunitTools::equalTo(10)]"/>
            <munit-tools:assert-that expression="#[vars.onDisk]" is="#[MunitTools::equalTo(40)]"/>
            <munit-tools:assert-that expression="#[vars.again]" is="#[MunitTools::equalTo(10)]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="file-store-temporary-file-deleted-after-flow-test" description="Runs after the tests above: the temporary files they wrote are deleted once their flows have finished and the chunks are collected">
        <munit:execution>
            <set-variable variableName="files" value="#[java!com::mulesoftforge::mule::extension::chunking::test::TempFiles::fileStoreFilesAfterCollection(10000)]"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.files]" is="#[MunitTools::equalTo(0)]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="file-store-writes-nothing-when-chunks-fit-in-memory-test" description="file-store writes nothing to disk when every chunk fits within maxInMemoryChunks">
        <munit:execution>
            <set-payload value="#[(1 to 50) map &quot;x&quot; joinBy &quot;&quot;]"/>
            <chunking:read-chunked><chunking:chunking-strategy><chunking:by-size chunkSize="5"/></chunking:chunking-strategy><chunking:streaming-strategy><chunking:file-store maxInMemoryChunks="10"/></chunking:streaming-strategy></chunking:read-chunked>
            <set-variable variableName="bytesBefore" value="#[java!com::mulesoftforge::mule::extension::chunking::test::TempFiles::fileStoreBytes()]"/>
            <foreach><logger level="DEBUG" message="#[payload.index]"/></foreach>
            <set-variable variableName="files" value="#[java!com::mulesoftforge::mule::extension::chunking::test::TempFiles::fileStoreBytes() - vars.bytesBefore]"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.files]" is="#[MunitTools::equalTo(0)]"/>
        </munit:validation>
    </munit:test>
