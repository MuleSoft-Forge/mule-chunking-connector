    <munit:test name="in-memory-max-in-memory-chunks-test" description="in-memory fails the read at maxInMemoryChunks, after the chunks within it">
        <munit:execution>
            <set-payload value="#[(1 to 50) map &quot;x&quot; joinBy &quot;&quot;]"/>
            <chunking:read-chunked><chunking:chunking-strategy><chunking:by-size chunkSize="5"/></chunking:chunking-strategy><chunking:streaming-strategy><chunking:in-memory maxInMemoryChunks="4"/></chunking:streaming-strategy></chunking:read-chunked>
            <set-variable variableName="seen" value="#[0]"/>
            <set-variable variableName="caught" value="nothing"/>
            <set-variable variableName="description" value=""/>
            <try>
                <foreach><set-variable variableName="seen" value="#[vars.seen + 1]"/></foreach>
                <error-handler>
                    <on-error-continue type="ANY">
                        <set-variable variableName="caught" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                        <set-variable variableName="description" value="#[error.description]"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.caught]" is="#[MunitTools::equalTo(&quot;MULE:UNKNOWN&quot;)]"/>
            <munit-tools:assert-that expression="#[vars.seen]" is="#[MunitTools::equalTo(4)]"/>
            <munit-tools:assert-that expression="#[vars.description]" is="#[MunitTools::containsString(&quot;limit of 4 chunks held in memory&quot;)]"/>
        </munit:validation>
    </munit:test>

