    <munit:test name="file-store-default-keeps-ten-chunks-in-memory-test" description="file-store with no setting keeps 10 chunks in memory and writes the eleventh to disk">
        <munit:execution>
            <set-variable variableName="bytesBefore" value="#[java!com::mulesoftforge::mule::extension::chunking::test::TempFiles::fileStoreBytes()]"/>
            <set-payload value="#[(1 to 55) map &quot;x&quot; joinBy &quot;&quot;]"/>
            <chunking:read-chunked><chunking:chunking-strategy><chunking:by-size chunkSize="5"/></chunking:chunking-strategy><chunking:streaming-strategy><chunking:file-store/></chunking:streaming-strategy></chunking:read-chunked>
            <set-variable variableName="seen" value="#[0]"/>
            <foreach><set-variable variableName="seen" value="#[vars.seen + 1]"/></foreach>
            <set-variable variableName="onDisk" value="#[java!com::mulesoftforge::mule::extension::chunking::test::TempFiles::fileStoreBytes() - vars.bytesBefore]"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.seen]" is="#[MunitTools::equalTo(11)]"/>
            <munit-tools:assert-that expression="#[vars.onDisk]" is="#[MunitTools::equalTo(5)]"/>
        </munit:validation>
    </munit:test>

