            <set-payload value="#[(1 to 50) map &quot;x&quot; joinBy &quot;&quot;]"/>
            <chunking:read-chunked><chunking:chunking-strategy><chunking:by-size chunkSize="5"/></chunking:chunking-strategy><chunking:streaming-strategy><chunking:sliding-window readers="2"/></chunking:streaming-strategy></chunking:read-chunked>
            <set-variable variableName="seen" value="#[0]"/>
            <set-variable variableName="description" value=""/>
            <try>
                <foreach><set-variable variableName="seen" value="#[vars.seen + 1]"/></foreach>
                <error-handler>
                    <on-error-continue type="ANY"><set-variable variableName="description" value="#[error.description]"/></on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.seen]" is="#[MunitTools::equalTo(3)]"/>
