    <munit:config name="streaming-strategies-test"/>

    <munit:test name="non-repeatable-by-size-test" description="The non-repeatable strategy chunking by size">
        <munit:execution>
            <set-payload value="#[&quot;a\nb\nc\nd\ne\n&quot;]"/>
            <chunking:read-chunked><chunking:chunking-strategy><chunking:by-size chunkSize="4"/></chunking:chunking-strategy><chunking:streaming-strategy><chunking:non-repeatable/></chunking:streaming-strategy></chunking:read-chunked>
            <set-variable variableName="first" value="#[[]]"/>
            <set-variable variableName="second" value="#[[]]"/>
            <foreach><set-variable variableName="first" value="#[vars.first + (payload.data as String)]"/></foreach>
            <try>
                <foreach><set-variable variableName="second" value="#[vars.second + (payload.data as String)]"/></foreach>
                <error-handler>
                    <on-error-continue type="ANY"><set-variable variableName="second" value="failed"/></on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.first]" is="#[MunitTools::equalTo([&quot;a\nb\n&quot;, &quot;c\nd\n&quot;, &quot;e\n&quot;])]"/>
            <munit-tools:assert-that expression="#[vars.second]" is="#[MunitTools::equalTo([])]"/>
        </munit:validation>
    </munit:test>

