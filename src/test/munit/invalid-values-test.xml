    <munit:test name="invalid-parameter-catches-invalid-delimiter-test" description="The parent INVALID_PARAMETER catches INVALID_DELIMITER">
        <munit:execution>
            <set-payload value='#["a\nb\n"]'/>
            <set-variable variableName="caught" value="nothing"/>
            <try>
                <chunking:read-chunked>
                    <chunking:chunking-strategy>
                        <chunking:by-delimiter delimiter="#['']" recordsPerChunk="2"/>
                    </chunking:chunking-strategy>
                </chunking:read-chunked>
                <error-handler>
                    <on-error-continue type="CHUNKING:INVALID_PARAMETER">
                        <set-variable variableName="caught" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                        <set-variable variableName="description" value="#[error.description]"/>
                    </on-error-continue>
                    <on-error-continue type="ANY">
                        <set-variable variableName="caught" value="#['other handler: ' ++ error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.caught]" is="#[MunitTools::equalTo(&quot;CHUNKING:INVALID_DELIMITER&quot;)]"/>
            <munit-tools:assert-that expression="#[vars.description]" is="#[MunitTools::containsString(&quot;(got: \&quot;\&quot;)&quot;)]"/>
        </munit:validation>
    </munit:test>
</mule>
