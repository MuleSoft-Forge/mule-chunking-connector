    <munit:config name="invalid-values-test"/>

    <munit:test name="invalid-chunk-size-zero-test" description="A chunk size of zero fails with INVALID_CHUNK_SIZE">
        <munit:execution>
            <set-payload value='#["a\nb\n"]'/>
            <set-variable variableName="caught" value="nothing"/>
            <try>
                <chunking:read-chunked>
                    <chunking:chunking-strategy>
                        <chunking:by-size chunkSize="0"/>
                    </chunking:chunking-strategy>
                </chunking:read-chunked>
                <error-handler>
                    <on-error-continue type="CHUNKING:INVALID_CHUNK_SIZE">
                        <set-variable variableName="caught" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                        <set-variable variableName="description" value="#[error.description]"/>
                    </on-error-continue>
                    <on-error-continue type="ANY">
                        <set-variable variableName="caught" value="#['other handler: ' ++ error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.caught]" is="#[MunitTools::equalTo(&quot;CHUNKING:INVALID_CHUNK_SIZE&quot;)]"/>
            <munit-tools:assert-that expression="#[vars.description]" is="#[MunitTools::containsString(&quot;(got: 0)&quot;)]"/>
        </munit:validation>
    </munit:test>

