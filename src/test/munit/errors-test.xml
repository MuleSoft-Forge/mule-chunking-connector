            <munit-tools:assert-that expression="#[vars.description]" is="#[MunitTools::containsString(&quot;Simulated source failure after 2500 bytes&quot;)]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="record-too-large-is-raised-test" description="A record larger than maxChunkSize fails while foreach reads, as MULE:UNKNOWN, after the chunks before it" timeOut="30000">
        <munit:execution>
            <set-payload value="#[&quot;ok\n&quot; ++ ((1 to 50) map &quot;x&quot; joinBy &quot;&quot;) ++ &quot;\nlater\n&quot;]"/>
            <set-variable variableName="seen" value="#[0]"/>
            <set-variable variableName="caught" value="nothing"/>
            <try>
                <chunking:read-chunked><chunking:chunking-strategy><chunking:by-delimiter recordsPerChunk="1" maxChunkSize="20"/></chunking:chunking-strategy></chunking:read-chunked>
                <foreach><set-variable variableName="seen" value="#[vars.seen + 1]"/></foreach>
                <set-variable variableName="caught" value="no error: the content ended normally"/>
                <error-handler>
                    <on-error-continue type="ANY">
                        <set-variable variableName="caught" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                        <set-variable variableName="description" value="#[error.description]"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.caught]" is="#[MunitTools::equalTo(&quot;MULE:UNKNOWN&quot;)]"/>
            <munit-tools:assert-that expression="#[vars.seen]" is="#[MunitTools::equalTo(1)]"/>
            <munit-tools:assert-that expression="#[vars.description]" is="#[MunitTools::containsString(&quot;is larger than the maximum chunk size of 20 bytes&quot;)]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="no-content-read-error-test" description="No content fails with CHUNKING:READ_ERROR, caught by type" timeOut="30000">
        <munit:execution>
            <set-payload value="#[null]"/>
            <set-variable variableName="seen" value="#[0]"/>
            <set-variable variableName="caught" value="nothing"/>
            <try>
                <chunking:read-chunked><chunking:chunking-strategy><chunking:by-size chunkSize="1000"/></chunking:chunking-strategy></chunking:read-chunked>
                <foreach><set-variable variableName="seen" value="#[vars.seen + 1]"/></foreach>
                <set-variable variableName="caught" value="no error: the content ended normally"/>
                <error-handler>
                    <on-error-continue type="CHUNKING:READ_ERROR">
                        <set-variable variableName="caught" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                        <set-variable variableName="description" value="#[error.description]"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.caught]" is="#[MunitTools::equalTo(&quot;CHUNKING:READ_ERROR&quot;)]"/>
            <munit-tools:assert-that expression="#[vars.seen]" is="#[MunitTools::equalTo(0)]"/>
            <munit-tools:assert-that expression="#[vars.description]" is="#[MunitTools::containsString(&quot;There is no content to chunk (got: null)&quot;)]"/>
        </munit:validation>
    </munit:test>
</mule>
