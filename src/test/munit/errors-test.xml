            <set-variable variableName="seen" value="#[0]"/>
            <set-variable variableName="caught" value="nothing"/>
            <try>
                <chunking:read-chunked><chunking:chunking-strategy><chunking:by-delimiter delimiter="x" recordsPerChunk="500"/></chunking:chunking-strategy></chunking:read-chunked>
                <foreach><set-variable variableName="seen" value="#[vars.seen + 1]"/></foreach>
                <set-variable variableName="caught" value="no error: the content ended normally"/>
                <error-handler>
                    <on-error-continue type="ANY">
                        <set-variable variableName="caught" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                        <set-variable variableName="description" value="#[error.description]"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.caught]" is="#[MunitTools::equalTo(&quot;MULE:UNKNOWN&quot;)]"/>
            <munit-tools:assert-that expression="#[vars.seen]" is="#[MunitTools::equalTo(4)]"/>
            <munit-tools:assert-that expression="#[vars.description]" is="#[MunitTools::containsString(&quot;Simulated source failure after 2500 bytes&quot;)]"/>
        </munit:validation>
    </munit:test>

    <munit:test name="read-failure-in-dataweave-expression-is-raised-test" description="A source failure while a DataWeave expression reads the chunks is raised as MULE:EXPRESSION" timeOut="30000">
        <munit:execution>
            <set-payload value="#[java!com::mulesoftforge::mule::extension::chunking::test::FailingInputStreams::failAfter(2500)]"/>
            <set-variable variableName="seen" value="#[0]"/>
            <set-variable variableName="caught" value="nothing"/>
            <try>
                <chunking:read-chunked><chunking:chunking-strategy><chunking:by-size chunkSize="1000"/></chunking:chunking-strategy></chunking:read-chunked>
                <set-variable variableName="seen" value="#[sizeOf(payload)]"/>
                <set-variable variableName="caught" value="no error: the content ended normally"/>
                <error-handler>
                    <on-error-continue type="ANY">
                        <set-variable variableName="caught" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]"/>
                        <set-variable variableName="description" value="#[error.description]"/>
